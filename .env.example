# ── Odysseus Docker Configuration ──────────────────────────────────────────────
# Copy this to .env and fill in values before running docker compose up.

# App bind address and port (host:port mapping)
APP_BIND=127.0.0.1
APP_PORT=7000

# Supabase (pre-populated in the hosted environment; fill for local Docker)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM / AI providers
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# SearXNG (auto-generated if left blank)
SEARXNG_SECRET=

# ChromaDB bind (host port for direct access)
CHROMADB_BIND=127.0.0.1

# ntfy
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
